# Copy to .env and fill only with credentials issued through an authorized
# Booking.com Connectivity integration. Never commit .env.
BOOKING_CLIENT_ID=
BOOKING_CLIENT_SECRET=

# Map the four stable property keys to Booking.com hotel IDs.
BOOKING_PROPERTY_IDS='{"olympic-paddington":"","potts-point":"","central-sydney":"","darling-harbour":""}'

# Local path for the SQLite review store.
AZZURO_DB_PATH=data/reviews.sqlite3
